{
  "name": "Telegram Username Checker API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/telegram-username-checker-api",
  "description": "Asynchronous bulk Telegram username registration verification API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/telegram-username-checker",
  "canonical_docs": "https://docs.numberchecker.ai/telegram-username-checker",
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "username"
  },
  "products": [
    {
      "type": "tg_username",
      "name": "Registration Checker",
      "min": 1000,
      "max": 10000000,
      "fields": [
        "username",
        "activated"
      ],
      "fields_note": "Verified against live sample; username and activated are the current output fields."
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
